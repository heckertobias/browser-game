@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = T["ConfirmEmail.Title"].Value;
}
@if (Model.Confirmed)
{
    <p>@T["ConfirmEmail.Confirmed"]</p>
    <a href="/play" class="btn btn-primary rounded-none font-mono uppercase" data-testid="play">@T["ConfirmEmail.PlayNow"]</a>
}
else
{
    <div class="alert alert-error rounded-none" role="alert">@T["ConfirmEmail.Invalid"]</div>
    <a class="link text-sm" href="/Account/ResendConfirmation">@T["Common.ResendConfirmation"]</a>
}
