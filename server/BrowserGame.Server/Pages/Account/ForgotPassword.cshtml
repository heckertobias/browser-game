@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = T["ForgotPassword.Title"].Value;
}
@if (Model.Sent)
{
    <p>@T["ForgotPassword.Sent"]</p>
    <div class="flex flex-col gap-3 text-sm">
        <a class="link" href="/Account/Login">@T["ForgotPassword.BackToLogin"]</a>
    </div>
}
else
{
    <p>@T["ForgotPassword.Intro"]</p>
    <partial name="_Errors" />
    <form method="post" class="flex flex-col gap-3">
        <label class="flex flex-col gap-1">
            <span class="label-text">@T["Common.Email"]</span>
            <input asp-for="Email" type="email" autocomplete="username" class="input input-bordered w-full rounded-none" />
        </label>
        <button type="submit" class="btn btn-primary rounded-none font-mono uppercase">@T["ForgotPassword.Submit"]</button>
    </form>
    <a class="link text-sm" href="/Account/Login">@T["ForgotPassword.BackToLogin"]</a>
}
