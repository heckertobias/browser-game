@page
@model ResendConfirmationModel
@{
    ViewData["Title"] = T["ResendConfirmation.Title"].Value;
}
@if (Model.Sent)
{
    <p>@T["ResendConfirmation.Sent"]</p>
}
else
{
    <partial name="_Errors" />
    <form method="post" class="flex flex-col gap-3">
        <label class="flex flex-col gap-1">
            <span class="label-text">@T["Common.Email"]</span>
            <input asp-for="Email" type="email" autocomplete="username" class="input input-bordered w-full rounded-none" />
        </label>
        <button type="submit" class="btn btn-primary rounded-none font-mono uppercase">@T["ResendConfirmation.Submit"]</button>
    </form>
}
