@page
@model ResendConfirmationModel
@{
    ViewData["Title"] = "Bestätigungsmail";
}
@if (Model.Sent)
{
    <p>Falls es zu dieser Adresse einen noch nicht bestätigten Account gibt, haben wir dir eine neue Mail geschickt.</p>
}
else
{
    <partial name="_Errors" />
    <form method="post" class="flex flex-col gap-3">
        <label class="flex flex-col gap-1">
            <span class="label-text">E-Mail</span>
            <input asp-for="Email" type="email" autocomplete="username" class="input input-bordered w-full rounded-none" />
        </label>
        <button type="submit" class="btn btn-primary rounded-none font-mono uppercase">Mail senden</button>
    </form>
}
