@page
@model ManageModel
@{
    ViewData["Title"] = T["Manage.Title"].Value;
}
<partial name="_Errors" />
@if (Model.Message is not null)
{
    <div class="alert alert-success rounded-none" role="status">@Model.Message</div>
}
<p class="text-sm">@T["Manage.SignedInAs", Model.Name, Model.Email]</p>

<h2 class="font-mono uppercase">@T["Manage.PasskeysHeading"]</h2>
@if (Model.Passkeys.Count == 0)
{
    <p>@T["Manage.NoPasskeys"]</p>
}
<ul class="flex flex-col gap-2">
    @foreach (var passkey in Model.Passkeys)
    {
        <li class="flex flex-wrap items-center justify-between gap-2 border-2 border-base-content/20 p-2">
            <span class="min-w-0 break-words">@T["Manage.PasskeyLabel", passkey.Number, passkey.CreatedOn]</span>
            @if (Model.CanRemove)
            {
                <form method="post" asp-page-handler="RemovePasskey">
                    <input type="hidden" name="PasskeyId" value="@passkey.Id" />
                    <button type="submit" class="btn btn-ghost rounded-none font-mono uppercase">@T["Manage.RemovePasskey"]</button>
                </form>
            }
        </li>
    }
</ul>
@if (!Model.CanRemove && Model.Passkeys.Count > 0)
{
    <p class="text-sm">@T["Manage.LastCredentialHint"]</p>
}

<h2 class="font-mono uppercase">@T["Manage.PasswordHeading"]</h2>
@if (Model.HasPassword)
{
    <p>@T["Manage.HasPassword"]</p>
}
else
{
    <p>@T["Manage.NoPassword"]</p>
    <form method="post" asp-page-handler="SetPassword" class="flex flex-col gap-3">
        <label class="flex flex-col gap-1">
            <span class="label-text">@T["ResetPassword.PasswordLabel"]</span>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" class="input input-bordered w-full rounded-none" />
        </label>
        <label class="flex flex-col gap-1">
            <span class="label-text">@T["ResetPassword.ConfirmPasswordLabel"]</span>
            <input asp-for="ConfirmNewPassword" type="password" autocomplete="new-password" class="input input-bordered w-full rounded-none" />
        </label>
        <button type="submit" class="btn btn-primary rounded-none font-mono uppercase">@T["Manage.SetPassword"]</button>
    </form>
}

<div class="flex flex-wrap items-center gap-2">
    <form method="post" asp-page="/Account/Logout">
        <button type="submit" class="btn btn-ghost rounded-none font-mono uppercase">@T["Index.SignOut"]</button>
    </form>
    <a href="/Account/Delete" class="btn btn-outline btn-error rounded-none font-mono uppercase">@T["Manage.DeleteLink"]</a>
    <a href="/play" class="link text-sm">@T["Index.Play"]</a>
</div>
