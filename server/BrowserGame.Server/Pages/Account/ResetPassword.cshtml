@page
@model ResetPasswordModel
@{
    ViewData["Title"] = T["ResetPassword.Title"].Value;
}
@if (Model.Done)
{
    <p>@T["ResetPassword.Done"]</p>
    <a href="/Account/Login" class="btn btn-primary rounded-none font-mono uppercase">@T["Common.SignIn"]</a>
}
else if (Model.Invalid)
{
    <div class="alert alert-error rounded-none" role="alert">@T["ResetPassword.Invalid"]</div>
    <a class="link text-sm" href="/Account/ForgotPassword">@T["ResetPassword.RequestNew"]</a>
}
else
{
    <partial name="_Errors" />
    <form method="post" class="flex flex-col gap-3">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Code" />
        <label class="flex flex-col gap-1">
            <span class="label-text">@T["ResetPassword.PasswordLabel"]</span>
            <input asp-for="Password" type="password" autocomplete="new-password" class="input input-bordered w-full rounded-none" />
        </label>
        <label class="flex flex-col gap-1">
            <span class="label-text">@T["ResetPassword.ConfirmPasswordLabel"]</span>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="input input-bordered w-full rounded-none" />
        </label>
        <button type="submit" class="btn btn-primary rounded-none font-mono uppercase">@T["ResetPassword.Submit"]</button>
    </form>
}
