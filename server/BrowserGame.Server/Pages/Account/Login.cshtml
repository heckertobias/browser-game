@page
@model LoginModel
@{
    ViewData["Title"] = "Anmelden";
}
<partial name="_Errors" />

@if (!string.IsNullOrEmpty(Model.ReturnUrl))
{
    <p>Melde dich an, um zu spielen.</p>
}

<form method="post" class="flex flex-col gap-3">
    <input type="hidden" asp-for="ReturnUrl" />
    <label class="flex flex-col gap-1">
        <span class="label-text">E-Mail</span>
        <input asp-for="Email" type="email" autocomplete="username" class="input input-bordered w-full rounded-none" />
    </label>
    <label class="flex flex-col gap-1">
        <span class="label-text">Passwort</span>
        <input asp-for="Password" type="password" autocomplete="current-password" class="input input-bordered w-full rounded-none" />
    </label>
    <button type="submit" class="btn btn-primary rounded-none font-mono uppercase">Anmelden</button>
</form>

<div class="flex flex-col gap-1 text-sm">
    <a class="link" href="/Account/Register">Noch keinen Account? Registrieren</a>
    <a class="link" href="/Account/ResendConfirmation">Bestätigungsmail erneut senden</a>
</div>
