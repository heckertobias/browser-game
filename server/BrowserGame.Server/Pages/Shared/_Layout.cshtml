@{
    var isHome = ViewData["Home"] is true;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]@(isHome ? "" : " – " + T["Common.GameName"])</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="@T["Common.GameName"]" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-dvh bg-base-200 flex items-center justify-center p-2 sm:p-4">
    <main class="card bg-base-100 shadow-xl w-full max-w-md border-4 border-base-content/20 rounded-none">
        <div class="card-body gap-4">
            <div class="flex items-center gap-2">
                @if (!isHome)
                {
                    <a href="/" class="font-mono text-xs uppercase tracking-widest opacity-60">@T["Common.GameName"]</a>
                }
                <partial name="_LanguageSwitch" />
            </div>
            <h1 class="card-title text-2xl sm:text-3xl font-mono uppercase tracking-widest break-words hyphens-auto">@ViewData["Title"]</h1>
            @RenderBody()
        </div>
    </main>
    <script type="module" src="~/js/language.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
