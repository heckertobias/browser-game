@page
@{
    ViewData["Title"] = "Browser Game";
    ViewData["Home"] = true;
}
<p>Eine Fantasy-Welt im Browser. Kein Download – einfach loslaufen.</p>
<a href="/play" class="btn btn-primary btn-lg rounded-none font-mono uppercase" data-testid="play">Spielen</a>
@if (User.Identity?.IsAuthenticated == true)
{
    <p class="text-sm">Angemeldet als @User.Identity.Name</p>
    <form method="post" asp-page="/Account/Logout">
        <button type="submit" class="btn btn-ghost btn-sm rounded-none font-mono uppercase">Abmelden</button>
    </form>
}
else
{
    <div class="flex gap-2">
        <a href="/Account/Login" class="btn btn-sm rounded-none font-mono uppercase">Anmelden</a>
        <a href="/Account/Register" class="btn btn-sm rounded-none font-mono uppercase">Registrieren</a>
    </div>
}
