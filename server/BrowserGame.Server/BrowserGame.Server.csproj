<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- Transitiv über MimeKit; 10.0.0 hat GHSA-2fmv-rv2c-59x7 / GHSA-846f-f764-76mx, gefixt ab 10.0.13. Entfernen, sobald MailKit es selbst mitbringt. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Typen nur aus contracts/ (Constitution §3). -->
  <ItemGroup>
    <Protobuf Include="../../contracts/proto/**/*.proto" ProtoRoot="../../contracts/proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Accounts/blocked-names.txt" LogicalName="BrowserGame.Server.Accounts.blocked-names.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrowserGame.Server.Tests" />
  </ItemGroup>

</Project>
