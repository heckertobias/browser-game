<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Typen nur aus contracts/ (Constitution §3). -->
  <ItemGroup>
    <Protobuf Include="../../contracts/proto/**/*.proto" ProtoRoot="../../contracts/proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserGame.Data\BrowserGame.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Features/Accounts/Domain/blocked-names.txt" LogicalName="BrowserGame.Server.Features.Accounts.blocked-names.txt" />
    <EmbeddedResource Include="Features/Pwa/Services/service-worker.js" LogicalName="BrowserGame.Server.Features.Pwa.service-worker.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrowserGame.Server.Tests" />
  </ItemGroup>

</Project>
