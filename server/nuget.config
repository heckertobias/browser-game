<?xml version="1.0" encoding="utf-8"?>
<!-- Nur nuget.org. dotnet package add/update wählt nur Versionen, die mindestens 7 Tage alt sind (ADR 0002). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="168" />
  </packageSources>
</configuration>
