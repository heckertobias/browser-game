@page
@model LoginTwoFactorModel
@{
    ViewData["Title"] = T["LoginTwoFactor.Title"].Value;
    Layout = "_LayoutPlain";
}
<partial name="_Errors" />
<form method="post">
    <div class="mb-3">
        <label asp-for="Code" class="form-label">@T["LoginTwoFactor.Code"]</label>
        <input asp-for="Code" autocomplete="one-time-code" inputmode="text" class="form-control font-monospace" aria-describedby="two-factor-code-hint" />
        <span asp-validation-for="Code" class="invalid-feedback"></span>
        <div id="two-factor-code-hint" class="form-text">@T["LoginTwoFactor.CodeHint"]</div>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsRecoveryCode" type="checkbox" class="form-check-input" />
        <label asp-for="IsRecoveryCode" class="form-check-label">@T["LoginTwoFactor.IsRecoveryCode"]</label>
    </div>
    <button type="submit" class="btn btn-primary w-100">@T["LoginTwoFactor.SignIn"]</button>
</form>
