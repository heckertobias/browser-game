@page
@model AccountModel
@{
    ViewData["Title"] = T["Layout.Account"].Value;
}
<partial name="_Errors" />
<partial name="_Message" model="new PageMessage(MessageKind.Success, Model.Message)" />

<div class="admin-narrow d-flex flex-column gap-4">
    <section class="card" aria-labelledby="account-passkeys">
        <h2 id="account-passkeys" class="card-header h6">@T["Account.Passkeys"]</h2>
        <div class="card-body">
            @if (Model.Passkeys.Count == 0)
            {
                <p class="text-body-secondary">@T["Account.NoPasskey"]</p>
            }
            else
            {
                <ul class="list-group mb-3" data-testid="passkeys">
                    @foreach (var passkey in Model.Passkeys)
                    {
                        <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                            <span>@passkey.Label</span>
                            <form method="post" asp-page-handler="RemovePasskey">
                                <input type="hidden" name="PasskeyId" value="@passkey.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">@T["Common.Remove"]</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            <form method="post" asp-page-handler="AddPasskey" data-passkey="create">
                <script type="application/json" data-passkey-options>@Html.Raw(BrowserGame.Data.WebDefaults.JsonForHtmlScript(Model.PasskeyOptions))</script>
                <input type="hidden" name="Credential" />
                <button type="submit" class="btn btn-primary">@T["Account.AddPasskey"]</button>
                <p class="text-danger small mt-2 mb-0" data-passkey-error hidden></p>
            </form>
        </div>
    </section>

    <section class="card" aria-labelledby="account-password">
        <h2 id="account-password" class="card-header h6">@T["Account.PasswordHeading"]</h2>
        <div class="card-body">
            @if (Model.HasPassword && Model.TwoFactorEnabled)
            {
                <p>@T["Account.PasswordActive"]</p>
                <form method="post" asp-page-handler="RecoveryCodes">
                    <button type="submit" class="btn btn-outline-secondary">@T["Account.NewRecoveryCodes"]</button>
                </form>
                @if (Model.NewRecoveryCodes.Count > 0)
                {
                    <p class="mt-3">@T["Account.RecoveryCodesShown"]</p>
                    <ul class="list-unstyled font-monospace mb-0" data-testid="recovery-codes">
                        @foreach (var code in Model.NewRecoveryCodes)
                        {
                            <li>@code</li>
                        }
                    </ul>
                }
            }
            else
            {
                <p class="mb-0">@T["Account.NoPassword"]</p>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/passkeys.js" asp-append-version="true"></script>
}
