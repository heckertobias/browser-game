@page
@using BrowserGame.Data
@model SmtpModel
@{
    ViewData["Title"] = "SMTP-Einstellungen";
}
<partial name="_Errors" />
@if (Model.Message is not null)
{
    <div class="alert alert-success rounded-none">@Model.Message</div>
}
@if (!Model.Configured)
{
    <div class="alert alert-warning rounded-none">Noch nicht gespeichert – das Spiel verschickt derzeit keine Mails.</div>
}

<form method="post" class="grid gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1 sm:col-span-2">
        <span class="label-text">Server (nur der Name, z. B. mx.mailhost.example)</span>
        <input asp-for="Input.Host" class="input w-full rounded-none" autocomplete="off" />
    </label>
    <label class="flex flex-col gap-1">
        <span class="label-text">Port (465 = SSL/TLS, 587 = STARTTLS)</span>
        <input asp-for="Input.Port" type="number" min="1" max="65535" class="input w-full rounded-none" />
    </label>
    <label class="flex flex-col gap-1">
        <span class="label-text">Verschlüsselung</span>
        <select asp-for="Input.Security" class="select w-full rounded-none">
            <option value="@SmtpSecurity.SslOnConnect">SSL/TLS (meist Port 465)</option>
            <option value="@SmtpSecurity.StartTls">STARTTLS (meist Port 587)</option>
            <option value="@SmtpSecurity.Auto">Automatisch</option>
            <option value="@SmtpSecurity.None">Keine (nur Testserver)</option>
        </select>
    </label>
    <label class="flex flex-col gap-1">
        <span class="label-text">Benutzername</span>
        <input asp-for="Input.Username" autocomplete="off" class="input w-full rounded-none" />
    </label>
    <label class="flex flex-col gap-1">
        <span class="label-text">Passwort @(Model.PasswordSet ? "(gesetzt – leer lassen = unverändert)" : "")</span>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" value="" class="input w-full rounded-none" />
    </label>
    <label class="flex flex-col gap-1">
        <span class="label-text">Absender-Adresse</span>
        <input asp-for="Input.FromAddress" type="email" class="input w-full rounded-none" />
    </label>
    <label class="flex flex-col gap-1">
        <span class="label-text">Absender-Name</span>
        <input asp-for="Input.FromName" class="input w-full rounded-none" placeholder="Browser Game" />
    </label>

    <div class="divider font-mono text-xs sm:col-span-2">Testen, bevor du speicherst</div>
    <label class="flex flex-col gap-1 sm:col-span-2">
        <span class="label-text">Testmail an</span>
        <input asp-for="TestRecipient" type="email" class="input w-full rounded-none" />
    </label>
    <button type="submit" asp-page-handler="Test" class="btn rounded-none font-mono uppercase">Testmail senden</button>
    <button type="submit" asp-page-handler="Save" class="btn btn-primary rounded-none font-mono uppercase">Speichern</button>
    <p class="text-sm opacity-70 sm:col-span-2">Die Testmail nutzt die Werte im Formular (nicht gespeichert). Leeres Passwortfeld = gespeichertes Passwort.</p>
</form>
