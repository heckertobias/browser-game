@page
@using BrowserGame.Data
@model SmtpModel
@{
    ViewData["Title"] = T["Nav.Smtp"].Value;
}
<partial name="_Errors" />
<partial name="_Message" model="new PageMessage(MessageKind.Success, Model.Message)" />
@if (!Model.Configured)
{
    <partial name="_Message" model='new PageMessage(MessageKind.Warning, T["Smtp.NotSaved"].Value)' />
}

<form method="post" class="admin-narrow d-flex flex-column gap-4">
    <div class="card">
        <h2 class="card-header h6">@T["Smtp.Connection"]</h2>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.Host" class="form-label">@T["Smtp.Host"]</label>
                    <input asp-for="Input.Host" class="form-control" autocomplete="off" aria-describedby="smtp-host-hint" />
                    <span asp-validation-for="Input.Host" class="invalid-feedback"></span>
                    <div id="smtp-host-hint" class="form-text">@T["Smtp.HostHint"]</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Port" class="form-label">@T["Smtp.Port"]</label>
                    <input asp-for="Input.Port" type="number" min="1" max="65535" class="form-control" aria-describedby="smtp-port-hint" />
                    <span asp-validation-for="Input.Port" class="invalid-feedback"></span>
                    <div id="smtp-port-hint" class="form-text">@T["Smtp.PortHint"]</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Security" class="form-label">@T["Smtp.Security"]</label>
                    <select asp-for="Input.Security" class="form-select">
                        <option value="@SmtpSecurity.SslOnConnect">@T["Smtp.Security.SslOnConnect"]</option>
                        <option value="@SmtpSecurity.StartTls">@T["Smtp.Security.StartTls"]</option>
                        <option value="@SmtpSecurity.Auto">@T["Smtp.Security.Auto"]</option>
                        <option value="@SmtpSecurity.None">@T["Smtp.Security.None"]</option>
                    </select>
                    <span asp-validation-for="Input.Security" class="invalid-feedback"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Username" class="form-label">@T["Smtp.Username"]</label>
                    <input asp-for="Input.Username" autocomplete="off" class="form-control" />
                    <span asp-validation-for="Input.Username" class="invalid-feedback"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Password" class="form-label">@T["Smtp.Password"]</label>
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" value="" class="form-control" aria-describedby="@(Model.PasswordSet ? "smtp-password-hint" : null)" />
                    <span asp-validation-for="Input.Password" class="invalid-feedback"></span>
                    @if (Model.PasswordSet)
                    {
                        <div id="smtp-password-hint" class="form-text">@T["Smtp.PasswordSet"]</div>
                    }
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.FromAddress" class="form-label">@T["Smtp.FromAddress"]</label>
                    <input asp-for="Input.FromAddress" type="email" class="form-control" />
                    <span asp-validation-for="Input.FromAddress" class="invalid-feedback"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.FromName" class="form-label">@T["Smtp.FromName"]</label>
                    <input asp-for="Input.FromName" class="form-control" placeholder="@T["Smtp.FromNamePlaceholder"]" />
                    <span asp-validation-for="Input.FromName" class="invalid-feedback"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <h2 class="card-header h6">@T["Smtp.TestHeading"]</h2>
        <div class="card-body">
            <label asp-for="TestRecipient" class="form-label">@T["Smtp.TestRecipient"]</label>
            <input asp-for="TestRecipient" type="email" class="form-control" aria-describedby="smtp-test-hint" />
            <span asp-validation-for="TestRecipient" class="invalid-feedback"></span>
            <div id="smtp-test-hint" class="form-text">@T["Smtp.TestHint"]</div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" asp-page-handler="Test" class="btn btn-outline-secondary">@T["Smtp.SendTest"]</button>
            </div>
        </div>
    </div>

    <div>
        <button type="submit" asp-page-handler="Save" class="btn btn-primary">@T["Smtp.Save"]</button>
    </div>
</form>
