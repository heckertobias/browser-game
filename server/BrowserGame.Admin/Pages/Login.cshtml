@page
@model LoginModel
@{
    ViewData["Title"] = T["Login.Title"].Value;
    Layout = "_LayoutPlain";
}
<partial name="_Errors" />

<form method="post" asp-page-handler="Passkey" data-passkey="get">
    <script type="application/json" data-passkey-options>@Html.Raw(BrowserGame.Data.WebDefaults.JsonForHtmlScript(Model.PasskeyOptions))</script>
    <input type="hidden" name="Credential" />
    <button type="submit" class="btn btn-primary w-100">
        <i class="bi bi-key me-2" aria-hidden="true"></i>@T["Login.WithPasskey"]
    </button>
    <p class="text-danger small mt-2 mb-0" data-passkey-error hidden></p>
</form>

<div class="d-flex align-items-center gap-2 my-4 text-body-secondary small">
    <hr class="flex-grow-1 m-0" />
    <span>@T["Login.OrPassword"]</span>
    <hr class="flex-grow-1 m-0" />
</div>

<form method="post" asp-page-handler="Password">
    <div class="mb-3">
        <label asp-for="Email" class="form-label">@T["Common.Email"]</label>
        <input asp-for="Email" type="email" autocomplete="username" class="form-control" />
        <span asp-validation-for="Email" class="invalid-feedback"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">@T["Common.Password"]</label>
        <input asp-for="Password" type="password" autocomplete="current-password" class="form-control" />
        <span asp-validation-for="Password" class="invalid-feedback"></span>
    </div>
    <button type="submit" class="btn btn-outline-secondary w-100">@T["Common.Continue"]</button>
</form>

@section Scripts {
    <script type="module" src="~/js/passkeys.js" asp-append-version="true"></script>
}
