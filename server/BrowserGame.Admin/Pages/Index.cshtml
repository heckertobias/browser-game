@page
@{
    ViewData["Title"] = T["Nav.Overview"].Value;
}
<p>@T["Index.Welcome"]</p>
<div class="list-group admin-narrow" data-testid="overview-links">
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="@Url.Page("/Smtp")">
        <i class="bi bi-envelope" aria-hidden="true"></i>@T["Nav.Smtp"]
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="@Url.Page("/Admins")">
        <i class="bi bi-people" aria-hidden="true"></i>@T["Nav.Admins"]
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="@Url.Page("/Audit")">
        <i class="bi bi-journal-text" aria-hidden="true"></i>@T["Nav.Audit"]
    </a>
</div>
