@page
@model AuditModel
@{
    ViewData["Title"] = "Protokoll";
}
@if (Model.Entries.Count == 0)
{
    <p>Noch keine Einträge.</p>
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Zeit</th><th>Admin</th><th>Aktion</th><th>Details</th></tr></thead>
        <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td class="font-mono whitespace-nowrap">@entry.At.LocalDateTime.ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>@entry.Admin</td>
                    <td>@entry.Action</td>
                    <td>@entry.Details</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-sm opacity-70">Angezeigt werden die letzten @AuditModel.Limit Einträge.</p>
}
