<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <partial name="_Head" />
</head>
<body>
    <main class="container min-vh-100 d-flex flex-column align-items-center justify-content-center py-4" data-testid="plain-layout">
        <p class="fs-5 fw-semibold mb-3">@T["Layout.Brand"]</p>
        <div class="card shadow-sm admin-plain-card" data-testid="plain-card">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">@ViewData["Title"]</h1>
                @RenderBody()
            </div>
        </div>
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
