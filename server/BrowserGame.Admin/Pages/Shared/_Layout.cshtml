<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] – Admin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-base-200">
    <header class="navbar bg-base-100 border-b-4 border-base-content/20 px-4">
        <a href="/" class="font-mono uppercase tracking-widest text-lg">Browser Game · Admin</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="ml-auto flex gap-1 font-mono text-sm">
                <a class="btn btn-ghost btn-sm rounded-none" href="/Smtp">SMTP</a>
                <a class="btn btn-ghost btn-sm rounded-none" href="/Admins">Admins</a>
                <a class="btn btn-ghost btn-sm rounded-none" href="/Audit">Protokoll</a>
                <a class="btn btn-ghost btn-sm rounded-none" href="/Account">@User.Identity.Name</a>
                <form method="post" action="/Logout"><button class="btn btn-ghost btn-sm rounded-none" type="submit">Abmelden</button></form>
            </nav>
        }
    </header>
    <main class="mx-auto max-w-3xl p-4">
        <section class="card bg-base-100 border-4 border-base-content/20 rounded-none">
            <div class="card-body gap-4">
                <h1 class="card-title text-2xl font-mono uppercase tracking-widest">@ViewData["Title"]</h1>
                @RenderBody()
            </div>
        </section>
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
