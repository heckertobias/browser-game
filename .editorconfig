root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props}]
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning

# Testnamen dürfen Unterstriche enthalten (lesbare Szenarien).
[server/BrowserGame.Server.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# Von EF Core erzeugte Migrationen nicht analysieren.
[server/BrowserGame.Data/Migrations/**.cs]
generated_code = true
