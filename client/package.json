{
  "name": "browsergame-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "cd .. && buf generate",
    "icons": "node scripts/icons.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && vite build && npm run build:landing && npm run build:admin && npm run build:passkeys",
    "build:landing": "tailwindcss -i src/styles/landing.css -o ../server/BrowserGame.Server/wwwroot/css/site.css --minify",
    "test": "npm run gen && vitest run",
    "typecheck": "npm run gen && tsc --noEmit",
    "lint": "npm run gen && oxlint",
    "build:admin": "node scripts/admin-lib.mjs",
    "build:passkeys": "vite build -c vite.passkeys.config.ts && mkdir -p ../server/BrowserGame.Admin/wwwroot/js && cp ../server/BrowserGame.Server/wwwroot/js/passkeys.js ../server/BrowserGame.Admin/wwwroot/js/passkeys.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "daisyui": "5.7.50",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
