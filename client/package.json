{
  "name": "browsergame-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "cd .. && buf generate",
    "dev": "npm run gen && vite",
    "build": "npm run gen && vite build && npm run build:landing",
    "build:landing": "tailwindcss -i src/landing.css -o ../server/BrowserGame.Server/wwwroot/css/site.css --minify",
    "test": "npm run gen && vitest run",
    "typecheck": "npm run gen && tsc --noEmit",
    "lint": "npm run gen && eslint ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "daisyui": "5.7.50",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
